{
  "name": "WF3b Chat Asisten Telegram",
  "nodes": [
    {
      "id": "5cec15ea-09f7-4154-92b0-a7397159cba9",
      "name": "Telegram_Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "cred-telegram",
          "name": "Telegram account"
        }
      },
      "parameters": {
        "updates": [
          "message"
        ]
      }
    },
    {
      "id": "48dfceef-3ed1-4d97-83bf-23386f20a6cb",
      "name": "Cek Allowlist Merchant",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        320,
        100
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "cred-pg-reader",
          "name": "Postgres mcp_reader"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT chat_id, merchant_id, label\nFROM ops.telegram_merchants\nWHERE chat_id = {{ $json.message.chat.id }};"
      }
    },
    {
      "id": "0b13e2b5-e440-4523-8ddf-35792e3047e0",
      "name": "Terdaftar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        540,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ Boolean($items().length > 0 && $json.merchant_id) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "9d4d083b-e1de-4f29-bbc8-5c22ba3f7c49",
      "name": "Tolak Chat Asing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        760,
        220
      ],
      "credentials": {
        "telegramApi": {
          "id": "cred-telegram",
          "name": "Telegram account"
        }
      },
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram_Trigger').item.json.message.chat.id }}",
        "text": "⛔ Akses ditolak. Akun Telegram Anda belum terdaftar di allowlist merchant H8Mart. Hubungi Tim Ops untuk pendaftaran."
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f1e7d13c-91ad-4002-b898-19e35a281293",
      "name": "Panggil Asisten AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-header-auth",
          "name": "Header Auth X-H8Mart-Token"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/merchant-assistant",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ merchant_id: $('Cek Allowlist Merchant').item.json.merchant_id, question: $('Telegram_Trigger').item.json.message.text }) }}"
      }
    },
    {
      "id": "9d9300ad-df3d-49f9-857d-6581953a406c",
      "name": "Kirim Jawaban Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        980,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "cred-telegram",
          "name": "Telegram account"
        }
      },
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram_Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.jawaban || 'Permintaan Anda sedang diproses oleh Tim CS H8Mart.' }}"
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Telegram_Trigger": {
      "main": [
        [
          {
            "node": "Cek Allowlist Merchant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cek Allowlist Merchant": {
      "main": [
        [
          {
            "node": "Terdaftar?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Terdaftar?": {
      "main": [
        [
          {
            "node": "Panggil Asisten AI",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tolak Chat Asing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Panggil Asisten AI": {
      "main": [
        [
          {
            "node": "Kirim Jawaban Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta",
    "saveExecutionProgress": false,
    "saveManualExecutions": true,
    "errorWorkflow": "fIaC1AzK9mQmzDc1"
  }
}
