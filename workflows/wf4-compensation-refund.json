      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops.refund_actions (order_id, idempotency_key, amount, status, note)\nVALUES (\n  '{{ $json.order_id }}',\n  '{{ $json.ref_idempotency_key }}',\n  {{ $json.refund_amount }},\n  CASE \n    WHEN NOT {{ $json.is_captured }} THEN 'rejected'\n    WHEN {{ $json.already_refunded }} THEN 'rejected'\n    WHEN {{ $json.needs_approval }} THEN 'pending_approval' \n    ELSE 'approved' \n  END,\n  CASE\n    WHEN NOT {{ $json.is_captured }} THEN 'Order belum dibayar'\n    WHEN {{ $json.already_refunded }} THEN 'Sudah diproses sebelumnya'\n    ELSE 'Order failed: {{ $json.fail_reason }}'\n  END\n)\nON CONFLICT (idempotency_key) DO UPDATE SET updated_at = now()\nRETURNING *;"
      }
    },
