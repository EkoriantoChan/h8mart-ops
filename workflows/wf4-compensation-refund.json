    {
      "id": "870ab19c-ea41-48cb-87ba-1a8bd738b454",
      "name": "Ambil Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        320,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "GANTI-ID-PG-OPS",
          "name": "Postgres ops_writer"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  '{{ $json.body.event }}' AS event_name,\n  '{{ $json.body.order_id }}' AS order_id,\n  {{ $json.body.minutes_late || 0 }} AS minutes_late,\n  '{{ ($json.body.reason || \"\").replace(/'/g, \"''\") }}' AS fail_reason,\n  o.customer_id,\n  o.merchant_id,\n  o.status,\n  o.total_amount,\n  o.payment_status,\n  (SELECT status FROM ops.compensations WHERE idempotency_key = 'comp-{{ $json.body.order_id }}') AS existing_comp_status,\n  (SELECT status FROM ops.refund_actions WHERE idempotency_key = 'ref-{{ $json.body.order_id }}') AS existing_ref_status,\n  COALESCE((SELECT chat_id::text FROM ops.telegram_merchants LIMIT 1), '1845199518') AS ops_chat_id\nFROM core.orders o\nWHERE o.order_id = '{{ $json.body.order_id }}';"
      }
    },
    {
      "id": "6697ffdf-0fe3-41f1-9e77-3acf37b5276d",
      "name": "Tentukan Kebijakan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        100
      ],
      "parameters": {
        "jsCode": "const event = $json.event_name;\nconst orderId = $json.order_id;\nconst minutesLate = Number($json.minutes_late) || 0;\nconst totalAmount = Number($json.total_amount) || 0;\nconst paymentStatus = $json.payment_status;\n\nlet voucherAmount = 0;\nif (event === 'delivery.late') {\n  voucherAmount = minutesLate <= 15 ? 10000 : 20000;\n}\n\nconst needsApproval = totalAmount > 100000;\nconst isCaptured = paymentStatus === 'captured';\nconst alreadyCompensated = Boolean($json.existing_comp_status === 'issued');\nconst alreadyRefunded = Boolean($json.existing_ref_status === 'refunded' || $json.existing_ref_status === 'rejected');\nconst refundEligible = Boolean(isCaptured && !alreadyRefunded);\n\nreturn [{\n  json: {\n    ...$json,\n    voucher_amount: voucherAmount,\n    refund_amount: totalAmount,\n    comp_idempotency_key: `comp-${orderId}`,\n    ref_idempotency_key: `ref-${orderId}`,\n    needs_approval: needsApproval,\n    is_captured: isCaptured,\n    already_compensated: alreadyCompensated,\n    already_refunded: alreadyRefunded,\n    refund_eligible: refundEligible\n  }\n}];"
      }
    },
    {
      "id": "0e43d12a-d275-4fff-93cb-1e370f74a796",
      "name": "Jenis Event?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        760,
        100
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "delivery.late",
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_name }}",
                    "rightValue": "delivery.late",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "order.failed",
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_name }}",
                    "rightValue": "order.failed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        }
