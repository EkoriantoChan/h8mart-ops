      },
      "parameters": {
        "operation": "sendMessage",
        "chatId": "1845199518",
        "text": "={{ $json.digest_message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "onError": "continueRegularOutput"
    },
