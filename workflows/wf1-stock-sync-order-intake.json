                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "1fcebacd-3c35-4edc-bc91-545c7fcc6e09",
      "name": "Respon 422 Tidak Valid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        500,
        1250
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\": \"invalid_event\", \"message\": \"Payload order.created tidak lengkap atau items kosong\"}",
        "options": {
