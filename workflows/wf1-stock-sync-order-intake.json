    {
      "id": "85ba4f68-f5c8-4a29-9238-1dbc6335d6d3",
      "name": "Alasan Batal Teratas",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1,
      "position": [
        720,
        1450
      ],
      "parameters": {
        "serverTransport": "sse",
        "endpointUrl": "http://n8n:5678/mcp/merchant-tools/sse",
        "authentication": "none",
        "tool": {
          "__rl": true,
          "mode": "list",
          "value": "Tool Alasan Batal"
        },
        "inputMode": "json",
        "jsonInput": "={{ JSON.stringify({ merchant_id: 'M003', date: $('Hitung KPI Harian').item.json.tanggal }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "165650ce-1eb6-4e71-b67a-255c7d2851d3",
      "name": "Tambah Alasan ke Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        950,
        1450
      ],
      "parameters": {
        "jsCode": "const kpi = $('Hitung KPI Harian').item.json;\nconst mcpOut = $json || {};\nconst reasonsList = mcpOut.ringkasan_alasan || [];\n\nlet reasonText = '';\nif (Array.isArray(reasonsList) && reasonsList.length > 0) {\n  reasonText = reasonsList.map(r => `• ${r.alasan}: ${r.jumlah}`).join('\\n');\n} else {\n  reasonText = 'Tidak ada pembatalan order terdata.';\n}\n\nconst message = `📊 *H8Mart Daily Operations Digest*\n📅 *Tanggal:* ${kpi.tanggal}\n\n📦 *Total Order:* ${kpi.total_orders}\n✅ *Terkirim:* ${kpi.delivered_orders}\n❌ *Batal/Gagal:* ${kpi.cancelled_orders}\n📉 *Cancel Rate:* ${kpi.cancel_rate_pct}%\n⏱️ *SLA 30 Menit:* ${kpi.sla_pct}% (${kpi.on_time_deliveries}/${kpi.delivered_orders})\n\n🔍 *Alasan Pembatalan Teratas (M003):*\n${reasonText}`;\n\nreturn [{\n  json: {\n    ...kpi,\n    digest_message: message\n  }\n}];"
      }
    },
    {
      "id": "a0dae13a-e764-4d80-a58e-43b868f85b1c",
      "name": "Kirim Digest Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1180,
        1450
      ],
      "credentials": {
