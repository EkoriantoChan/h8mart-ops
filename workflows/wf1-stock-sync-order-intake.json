      "webhookId": "3926d6b7-64b8-42b9-acd3-1e2f2bd9fb28",
      "credentials": {
        "httpHeaderAuth": {
          "id": "GANTI-ID-HEADER-AUTH",
          "name": "Header Auth X-H8Mart-Token"
        }
      },
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-digest",
        "authentication": "headerAuth",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "2376b0db-550a-40b9-b0d9-cbcce3eb9b0e",
      "name": "Hitung KPI Harian",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        300,
        1500
      ],
      "credentials": {
        "postgres": {
          "id": "GANTI-ID-PG-OPS",
          "name": "Postgres ops_writer"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target_date AS (\n  SELECT COALESCE(NULLIF('{{ $json.body?.tanggal || $json.query?.tanggal || \"\" }}', ''), (SELECT hari_data_terakhir::text FROM core.data_info))::date AS dt\n),\nord AS (\n  SELECT * FROM core.orders WHERE order_date = (SELECT dt FROM target_date)\n),\ndeliv AS (\n  SELECT d.* FROM core.deliveries d JOIN ord o USING (order_id) WHERE o.status = 'delivered'\n)\nSELECT\n  (SELECT dt::text FROM target_date) AS tanggal,\n  count(*)::int AS total_orders,\n  count(*) FILTER (WHERE status = 'delivered')::int AS delivered_orders,\n  count(*) FILTER (WHERE status IN ('cancelled', 'failed'))::int AS cancelled_orders,\n  ROUND(COALESCE(count(*) FILTER (WHERE status IN ('cancelled', 'failed'))::numeric / NULLIF(count(*), 0)::numeric * 100, 0), 2) AS cancel_rate_pct,\n  (SELECT count(*)::int FROM deliv WHERE actual_minutes <= promised_minutes) AS on_time_deliveries,\n  ROUND(COALESCE((SELECT count(*)::numeric FROM deliv WHERE actual_minutes <= promised_minutes) / NULLIF((SELECT count(*)::numeric FROM deliv), 0) * 100, 0), 2) AS sla_pct\nFROM ord;"
      }
    },
    {
      "id": "224dec87-5df3-4579-9301-1616701015a7",
      "name": "Digest Kosong?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        1500
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ Number($json.total_orders || 0) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "9a0a3027-cd78-43a1-b7c7-621a55c4f484",
      "name": "Gagal: Digest Kosong",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
