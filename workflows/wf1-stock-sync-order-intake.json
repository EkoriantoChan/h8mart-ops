    {
      "id": "53e071a3-cca0-445f-95ad-91b1ea053a80",
      "name": "Event Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        300,
        1100
      ],
      "parameters": {
        "conditions": {
          "options": {
