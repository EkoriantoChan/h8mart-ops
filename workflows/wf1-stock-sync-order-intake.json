        "operation": "executeQuery",
        "query": "INSERT INTO core.orders (order_id, customer_id, merchant_id, zone, order_date, created_at, status, total_amount, payment_status, customer_note)\nVALUES (\n  '{{ $json.order_id }}',\n  '{{ $json.customer_id }}',\n  '{{ $json.merchant_id }}',\n  COALESCE((SELECT zone FROM core.merchants WHERE merchant_id = '{{ $json.merchant_id }}'), 'Jakarta Selatan'),\n  CURRENT_DATE,\n  now(),\n  'active',\n  {{ $json.total_amount }},\n  'captured',\n  '{{ $json.customer_note }}'\n)\nON CONFLICT (order_id) DO NOTHING\nRETURNING *;"
      }
