    {
      "id": "108dc4fc-154c-4255-b572-5b8023d52e84",
      "name": "Cek Stok Order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        1050
      ],
      "credentials": {
        "postgres": {
          "id": "GANTI-ID-PG-OPS",
          "name": "Postgres ops_writer"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH order_input AS (\n  SELECT\n    '{{ $json.body.order_id }}' AS order_id,\n    '{{ $json.body.merchant_id }}' AS merchant_id,\n    '{{ $json.body.customer_id || \"C0001\" }}' AS customer_id,\n    {{ $json.body.total_amount || 0 }} AS total_amount,\n    '{{ ($json.body.customer_note || \"\").replace(/'/g, \"''\") }}' AS customer_note,\n    '{{ JSON.stringify($json.body.items) }}'::jsonb AS items\n),\nitems_expanded AS (\n  SELECT\n    UPPER(elem->>'sku') AS sku,\n    (elem->>'qty')::int AS req_qty\n  FROM order_input, jsonb_array_elements(items) elem\n),\nstock_check AS (\n  SELECT\n    ie.sku,\n    ie.req_qty,\n    p.product_id,\n    p.price,\n    COALESCE(s.qty, 0) AS current_qty\n  FROM items_expanded ie\n  JOIN core.products p ON p.sku = ie.sku\n  LEFT JOIN core.merchant_stock s ON s.product_id = p.product_id AND s.merchant_id = (SELECT merchant_id FROM order_input)\n),\nexisting_order AS (\n  SELECT count(*)::int AS cnt FROM core.orders WHERE order_id = (SELECT order_id FROM order_input)\n)\nSELECT\n  (SELECT order_id FROM order_input) AS order_id,\n  (SELECT merchant_id FROM order_input) AS merchant_id,\n  (SELECT customer_id FROM order_input) AS customer_id,\n  (SELECT total_amount FROM order_input) AS total_amount,\n  (SELECT customer_note FROM order_input) AS customer_note,\n  (SELECT cnt FROM existing_order) AS order_exists,\n  COALESCE(json_agg(stock_check.*), '[]'::json) AS items_detail,\n  MIN(stock_check.current_qty) AS min_stock,\n  BOOL_OR(stock_check.current_qty < stock_check.req_qty) AS has_stockout,\n  BOOL_OR(stock_check.current_qty - stock_check.req_qty <= 2) AS is_low_stock\nFROM stock_check;"
      }
    },
    {
      "id": "7f93a7ad-b663-486a-af81-9ca320bcbc73",
      "name": "Routing Stok",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        720,
        1050
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "cukup",
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.has_stockout }}",
                    "rightValue": false,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.is_low_stock }}",
                    "rightValue": false,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "tipis",
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.has_stockout }}",
                    "rightValue": false,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.is_low_stock }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "habis",
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.has_stockout }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "e91dc8bb-5be4-4741-b545-f5ec8ab79fef",
      "name": "Catat Order",
      "type": "n8n-nodes-base.postgres",
