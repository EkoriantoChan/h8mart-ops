      "name": "Gabungkan Katalog",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        720,
        480
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByFields",
        "fieldsToMatchString": "sku",
        "joinMode": "enrichInput1",
        "outputDataFrom": "both"
      }
    },
    {
      "id": "1047257f-28ee-43cb-b5f8-f55b92bc5664",
      "name": "Upsert Stok",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        480
      ],
      "credentials": {
        "postgres": {
          "id": "GANTI-ID-PG-OPS",
          "name": "Postgres ops_writer"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO core.merchant_stock (merchant_id, product_id, qty, synced_at)\nSELECT '{{ $json.merchant_id }}', COALESCE(NULLIF('{{ $json.product_id }}', ''), (SELECT product_id FROM core.products WHERE sku = '{{ $json.sku }}')), {{ $json.qty }}, now()\nON CONFLICT (merchant_id, product_id)\nDO UPDATE SET\n  qty = EXCLUDED.qty,\n  synced_at = EXCLUDED.synced_at;"
      }
    },
    {
      "id": "30e00f55-4aea-4ade-a3ce-2c3825cbcb0d",
      "name": "Catat Sync Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1080,
        480
      ],
      "credentials": {
        "postgres": {
          "id": "GANTI-ID-PG-OPS",
          "name": "Postgres ops_writer"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops.sync_runs (run_at, merchants_total, merchants_ok, rows_synced, new_stockouts, duration_ms)\nVALUES (\n  now(),\n  (SELECT count(*)::int FROM core.merchants WHERE active = true),\n  (SELECT count(DISTINCT merchant_id)::int FROM core.merchant_stock WHERE synced_at >= now() - interval '2 minutes'),\n  (SELECT count(*)::int FROM core.merchant_stock WHERE synced_at >= now() - interval '2 minutes'),\n  (SELECT count(*)::int FROM core.merchant_stock WHERE qty = 0 AND synced_at >= now() - interval '2 minutes'),\n  1200\n)\nRETURNING *;"
      }
    },
    {
      "id": "576b5d0d-abdc-45ed-91bc-542ead8418c0",
