        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: 'ops-alerts', title: 'Merchant Stock Sync Failed', text: 'Gagal mengambil stok merchant ' + $('Loop Per Merchant').item.json.merchant_id }) }}"
      },
      "onError": "continueRegularOutput"
