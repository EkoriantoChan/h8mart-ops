    {
      "id": "3c7deb20-e994-4fbc-bb6f-60c9abb65efb",
      "name": "Normalisasi Stok",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        480
      ],
      "parameters": {
        "jsCode": "const itemsOut = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  if (data && Array.isArray(data.items)) {\n    const mId = data.merchant_id;\n    for (const it of data.items) {\n      itemsOut.push({\n        json: {\n          merchant_id: mId,\n          sku: String(it.sku || '').toUpperCase(),\n          qty: parseInt(it.qty, 10) || 0\n        }\n      });\n    }\n  }\n}\n\nreturn itemsOut;"
      }
    },
