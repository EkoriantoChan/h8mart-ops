        "query": "INSERT INTO ops.dead_letter (workflow, node, execution_id, business_key, error_message, payload, attempts, status)\nVALUES (\n  'WF1',\n  'Ambil Stok Merchant API',\n  '{{ $execution.id }}',\n  '{{ $('Loop Per Merchant').item.json.merchant_id }}',\n  '{{ ($json.message || \"Merchant Stock API error\").replace(/'/g, \"''\") }}',\n  '{{ JSON.stringify($json) }}'::jsonb,\n  3,\n  'open'\n)\nRETURNING *;"
